---
interface Props {
  title: string;
}

const { title } = Astro.props;

// Fuente monoespaciada incluida en el proyecto: DejaVu Sans Mono (de la que deriva Menlo),
// recortada a los caracteres latinos y sin hinting (~8 KB por grosor). Licencia en src/assets/fonts.
// Al ser una fuente web, Chrome la incrusta una sola vez por grosor en el PDF;
// con una fuente del sistema en macOS la incrusta una vez por cada tamaño de letra.
import monoRegular from "../assets/fonts/dejavu-mono-400.woff2?url";
import monoBold from "../assets/fonts/dejavu-mono-700.woff2?url";

const fontFaces = [
  [400, monoRegular],
  [700, monoBold],
]
  .map(
    ([weight, url]) =>
      `@font-face{font-family:"DejaVu Mono";font-style:normal;font-weight:${weight};font-display:swap;src:url(${url}) format("woff2");}`,
  )
  .join("");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={monoRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoBold} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces}></style>
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      // La negrita monoespaciada solo se usa al imprimir: se carga por adelantado
      // para que esté lista cuando se abra el cuadro de impresión.
      document.fonts?.load('700 1em "DejaVu Mono"');
    </script>
  </body>
</html>

<style is:global>
  html {
    font-family:
      "DejaVu Mono",
      Menlo,
      Monaco,
      Lucida Console,
      "Courier New",
      Courier,
      monospace;
    background: #fff;
    letter-spacing: -0.025rem;
  }

  body,
  figure {
    margin: 0;
    padding: 0;
  }

  a {
    text-decoration: none;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  h1,
  h2,
  h3,
  h4 {
    margin: 0;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      Oxygen,
      Ubuntu,
      Cantarell,
      "Open Sans",
      "Helvetica Neue",
      sans-serif;
  }

  p {
	color:#666;
	font-size:.9rem;
	line-height: 1.5;
	margin: 0;
	text-wrap: pretty;
  }
  
  .print {
    display: none !important;
  }

  @media print {
    /* Sin márgenes de página, el navegador no tiene dónde imprimir
       la fecha, el título, la URL ni el número de página. */
    @page {
      margin: 0;
    }

    /* El margen se aplica dentro del contenido y se repite en cada página. */
    main {
      padding: 1.5cm !important;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }

    /* Una sola familia de fuente y solo dos grosores al imprimir:
       cada combinación fuente/grosor se incrusta en el PDF y aumenta su peso. */
    * {
      font-family: "DejaVu Mono", Menlo, Monaco, "Lucida Console", "Courier New", monospace !important;
      font-weight: 400 !important;
    }

    h1,
    section > h2,
    h3 {
      font-weight: 700 !important;
    }

    .print {
      display: block !important;
    }

    .no-print {
      display: none !important;
    }
  }
</style>
