---
import Section from "../Section.astro";

import { work } from "../../../cv.json";
---

<Section title="Experiencia laboral">
    <ul>
        {work.map(({ name, startDate, endDate, position, summary, 
            highlights }) => {
                const formatMonthYear = (dateStr: string): string => {
                    const [year, month] = dateStr.split("-");
                    return `${month}/${year}`; // Ej: "10/2026"
                    // Si no quieres el cero a la izquierda (ej. "3/2021"): `${Number(month)}/${year}`
                };
                const DateIn = formatMonthYear(startDate);
                const DateOut = endDate != null ? formatMonthYear(endDate) : "Actualidad";
                const timeLine = `${DateIn} - ${DateOut}`;
                return(
                    <li>
                        <article>
                            <header>
                                <div>
                                    <h3>{name}</h3>
                                    <h4>{position}</h4>
                                </div>
                                <time>{timeLine}</time>
                            </header>
                            
                            <footer>
                                <p>{summary}</p>
                            </footer>
                        </article>
                    </li>
                )
            }
        )}
    </ul>
</Section>

<style>
    ul {
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    article h3 {
        font-weight: 500;
        color: #111;        
    }

    article h4 {
        color: #222;
        font-weight: 400;
    }

    header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 4px;
    }

    time {
        font-size: 0.85rem;
        color: #555;
    }
</style>